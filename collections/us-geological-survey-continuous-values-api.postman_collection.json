          "id": "34194276-e806-4e24-aa9b-f03d65248667",
          "name": "Query Continuous Values",
          "request": {
            "name": "Query Continuous Values",
            "description": {
              "content": "Returns high-frequency continuous measurement data from USGS automated sensor networks. Includes streamflow, gage height, temperature, and hundreds of other parameters measured at monitoring locations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "collections",
                "continuous-values",
                "items"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bbox",
                  "value": "<number>,<number>,<number>,<number>",
                  "description": "Bounding box for spatial filtering (minLon,minLat,maxLon,maxLat)"
                },
                {
                  "disabled": false,
                  "key": "datetime",
                  "value": "<string>",
                  "description": "Date/time filter (RFC 3339 or ISO 8601, supports intervals with /)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of features to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Starting offset for pagination"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "CQL2 text filter expression for advanced querying"
                },
                {
                  "disabled": false,
                  "key": "f",
                  "value": "json",
                  "description": "Response format"
                },
                {
                  "disabled": false,
                  "key": "properties",
                  "value": "<string>,<string>",
                  "description": "Comma-separated list of properties to include in response"
                },
                {
                  "disabled": false,
                  "key": "sortby",
                  "value": "<string>",
                  "description": "Property name to sort results by (prefix with - for descending)"
                },
                {
                  "disabled": false,
                  "key": "monitoringLocationIdentifier",
                  "value": "<string>",
                  "description": "USGS monitoring location identifier (e.g., USGS-01646500)"
                },
                {
                  "disabled": false,
                  "key": "parameterCode",
                  "value": "<string>",
                  "description": "USGS parameter code for the measurement type (e.g., 00060 for discharge)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
